# Copy to .env and fill in. .env is gitignored and never baked into an image.

# --- Financial Modeling Prep ---
# The only secret Stage 1a needs.
SIENNER_FMP_API_KEY=

# Base URL and path are configurable because FMP's endpoint layout has moved
# between API generations. See backend/sienner/providers/fmp.py.
SIENNER_FMP_BASE_URL=https://financialmodelingprep.com
SIENNER_FMP_HISTORICAL_PATH=/stable/historical-price-eod/full
SIENNER_FMP_SPLITS_PATH=/stable/splits
SIENNER_FMP_DIVIDENDS_PATH=/stable/dividends

# --- Return basis ---
# Leave unset (or 'unresolved') and the tool serves a price return and says
# so. Set to pre_split or post_split ONLY after running:
#   cd backend && python -m sienner.scripts.fmp_spike
# Guessing this is wrong on exactly the tickers that split.
SIENNER_DIVIDEND_UNIT_CONVENTION=unresolved

# --- Database ---
POSTGRES_USER=sienner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sienner
SIENNER_DATABASE_URL=postgresql://sienner:change-me@db:5432/sienner

# Only used by tests/test_postgres_integration.py, which is skipped without it.
# SIENNER_TEST_DATABASE_URL=postgresql://sienner:change-me@localhost:5432/sienner

# --- Web ---
# ":80" for local Compose. On the VPS set a hostname and Caddy provisions TLS:
# SITE_ADDRESS=sienner.example.com
SITE_ADDRESS=:80
